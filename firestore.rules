rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // rankings/{small|large}/scores/{uid}: one entry per player and board class, the document id is the player's uid.
    match /rankings/{boardClass}/scores/{uid} {

      function validEntry(d) {
        return d.keys().hasOnly(['name', 'score', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 32   // the app allows 16 characters; emoji count double
          && d.score is int && d.score >= 0 && d.score <= 10000              // random texts score up to ~1600 (tools/score.cjs)
          && d.updatedAt == request.time;                                    // when this best was set: server time only, no forged dates
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow get: if true;
      allow list: if request.query.limit <= 50;                              // a query without a limit is refused

      allow create: if isOwner()
        && boardClass in ['small', 'large']
        && validEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;                  // first registration

      // a personal best only goes up; createdAt (first registration) never changes
      allow update: if isOwner()
        && validEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.score > resource.data.score;

      allow delete: if false;
    }
  }
}
